<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#4f46e5">
  <title><%= title ? `${title} · ${appName}` : appName %></title>
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <script src="/static/js/theme.js"></script>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body data-server-now="<%= Date.now() %>">
<% if (typeof bare === 'undefined' || !bare) { %>
<%
  const navs = !user ? [] : user.role === 'faculty'
    ? [['/faculty', 'Dashboard'], ['/faculty/classrooms/new', 'New classroom']]
    : [['/student', 'Dashboard'], ['/student/quizzes', 'Quizzes'], ['/student/classrooms', 'Classrooms']];
  const isActive = (href) => href === `/${user && user.role}` ? path === href : path === href || path.startsWith(href + '/');
%>
<header class="site-header">
  <div class="container">
    <% if (user) { %>
      <button class="icon-btn menu-toggle" data-menu-toggle aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    <% } %>
    <a class="brand" href="/"><span class="brand-mark">Q</span><span><%= appName %></span></a>
    <% if (user) { %>
      <nav class="main-nav" aria-label="Main">
        <% navs.forEach(([href, label]) => { %><a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>"><%= label %></a><% }) %>
      </nav>
    <% } %>
    <div class="header-actions">
      <button class="icon-btn" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <% if (user) { %>
        <a class="icon-btn" href="/notifications" aria-label="Notifications<%= unread ? ` (${unread} unread)` : '' %>" title="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <% if (unread) { %><span class="badge-dot"><%= unread > 9 ? '9+' : unread %></span><% } %>
        </a>
        <div class="user-menu">
          <button data-dropdown="user-dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
            <span class="avatar"><%= initials(user.name) %></span>
          </button>
          <div class="dropdown" id="user-dropdown">
            <div class="who"><strong><%= user.name %></strong><div class="muted small"><%= user.email %></div><span class="badge badge-primary mt-1"><%= user.role === 'faculty' ? 'Faculty' : 'Student' %></span></div>
            <a href="/account">My account</a>
            <a href="/notifications">Notifications</a>
            <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form>
          </div>
        </div>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Sign in</a>
        <a class="btn btn-primary btn-sm" href="/register">Get started</a>
      <% } %>
    </div>
  </div>
  <% if (user) { %>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
      <% navs.forEach(([href, label]) => { %><a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>"><%= label %></a><% }) %>
      <a href="/notifications">Notifications<%= unread ? ` (${unread})` : '' %></a>
      <a href="/account">My account</a>
    </nav>
  <% } %>
</header>
<% } %>
<% if (typeof bare === 'undefined' || !bare) { %>
<main>
  <div class="container">
<% } %>
    <% if ((typeof bare === 'undefined' || !bare) && flash && flash.length) { %>
      <div class="flash-stack" role="status">
        <% flash.forEach((f) => { %>
          <div class="alert alert-<%= f.type %>"><span><%= f.message %></span><button class="close" aria-label="Dismiss">×</button></div>
        <% }) %>
      </div>
    <% } %>
