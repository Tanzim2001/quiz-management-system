<%- include('../partials/head') %>
<div class="breadcrumb"><a href="/faculty">Dashboard</a> / <a href="/faculty/classrooms/<%= classroom.id %>"><%= classroom.name %></a> / New quiz</div>
<div class="page-head"><div><h1>New quiz</h1><p class="sub">Set up the schedule and rules. You'll add questions next.</p></div></div>
<div class="card" style="max-width: 820px">
  <form method="post" action="/faculty/classrooms/<%= classroom.id %>/quizzes" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/quiz-fields') %>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Create quiz &amp; add questions</button><a class="btn btn-ghost" href="/faculty/classrooms/<%= classroom.id %>">Cancel</a></div>
  </form>
</div>
<%- include('../partials/foot') %>
