<%- include('../partials/head') %>
<div class="breadcrumb"><a href="/faculty">Dashboard</a> / <a href="/faculty/classrooms/<%= quiz.classroom_id %>"><%= quiz.classroom_name %></a> / Quiz</div>
<div class="page-head">
  <div>
    <div class="row"><h1><%= quiz.title %></h1><%- include('../partials/status-badge', { status }) %></div>
    <p class="sub"><%= questions.length %> question<%= questions.length === 1 ? '' : 's' %> · <%= totalMarks %> marks · <%= quiz.duration_minutes %> min ·
      opens <time data-ts="<%= quiz.start_at %>"><%= fmtDate(quiz.start_at) %></time></p>
  </div>
  <div class="row">
    <% if (status !== 'draft') { %><a class="btn btn-outline" href="/faculty/quizzes/<%= quiz.id %>/results">📊 Results</a><% } %>
    <% if (!quiz.published) { %>
      <form method="post" action="/faculty/quizzes/<%= quiz.id %>/publish" data-confirm="Students in <%= quiz.classroom_name %> will see this quiz and be notified of its schedule." data-confirm-label="Publish">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary">Publish quiz</button>
      </form>
    <% } else if (status === 'live') { %>
      <form method="post" action="/faculty/quizzes/<%= quiz.id %>/close-now" data-confirm="Close the quiz now? Anyone still working will be submitted automatically." data-confirm-label="Close now" data-danger>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-outline">Close now</button>
      </form>
    <% } %>
  </div>
</div>

<% if (!quiz.published) { %>
  <div class="alert alert-warning mb-2">This quiz is a <strong>draft</strong>; students can't see it yet. Add questions, then press <strong>Publish quiz</strong>.</div>
<% } else if (status === 'upcoming') { %>
  <div class="alert alert-info mb-2">Published. It opens in <strong data-countdown="<%= quiz.start_at %>"></strong>. You can still edit questions until a student starts.</div>
<% } %>
<% if (locked) { %>
  <div class="alert alert-info mb-2 locked-note">🔒 Students have started this quiz, so questions are locked to keep scoring fair. You can still change the schedule and review settings.</div>
<% } %>

<div class="layout-side">
  <div class="stack">
    <section class="card" id="questions">
      <div class="card-head"><h2>Questions</h2><span class="muted small"><%= questions.length %> total · <%= totalMarks %> marks</span></div>
      <% if (!questions.length) { %><div class="empty"><div class="big">❓</div>No questions yet. Add one below or import a CSV.</div><% } %>
      <% questions.forEach((q, i) => { %>
        <details class="q-editor" id="q-<%= q.id %>">
          <summary>
            <span class="q-index"><%= i + 1 %></span>
            <div class="q-summary">
              <div class="t"><%= q.text %></div>
              <div class="q-answers"><% q.options.forEach((o, j) => { %><span class="<%= o.is_correct ? 'ok' : '' %>"><%= String.fromCharCode(65 + j) %>. <%= o.text %></span><% }) %></div>
            </div>
            <span class="badge"><%= q.marks %> mk</span>
          </summary>
          <div class="q-body">
            <% if (locked) { %>
              <% if (q.explanation) { %><div class="explanation"><strong>Explanation:</strong> <%= q.explanation %></div><% } else { %><p class="muted mb-0">No explanation.</p><% } %>
            <% } else { %>
              <%- include('../partials/question-form', { question: q, action: `/faculty/quizzes/${quiz.id}/questions/${q.id}`, formId: q.id, submitLabel: 'Save question' }) %>
              <div class="row mt-2">
                <form method="post" action="/faculty/quizzes/<%= quiz.id %>/questions/<%= q.id %>/move" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="direction" value="up"><button class="btn btn-ghost btn-sm" <%= i === 0 ? 'disabled' : '' %>>↑ Move up</button></form>
                <form method="post" action="/faculty/quizzes/<%= quiz.id %>/questions/<%= q.id %>/move" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="direction" value="down"><button class="btn btn-ghost btn-sm" <%= i === questions.length - 1 ? 'disabled' : '' %>>↓ Move down</button></form>
                <span class="spacer"></span>
                <form method="post" action="/faculty/quizzes/<%= quiz.id %>/questions/<%= q.id %>/delete" data-confirm="Delete question <%= i + 1 %>?" data-confirm-label="Delete" data-danger class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-outline btn-sm">Delete</button></form>
              </div>
            <% } %>
          </div>
        </details>
      <% }) %>
    </section>

    <% if (!locked) { %>
      <section class="card" id="add-question">
        <h2>Add a question</h2>
        <%- include('../partials/question-form', { question: null, action: `/faculty/quizzes/${quiz.id}/questions`, formId: 'new', submitLabel: '+ Add question' }) %>
      </section>
      <section class="card" id="import">
        <div class="card-head"><h2>Import questions from CSV</h2><a class="btn btn-ghost btn-sm" href="/faculty/import-template.csv">⬇ Download template</a></div>
        <p class="muted small">Columns: <code>question, option_a … option_f, correct, marks, explanation</code>. <code>correct</code> is a letter (A–F) or the text of the right option. You can export a Google Sheet or Excel file as CSV.</p>
        <form method="post" action="/faculty/quizzes/<%= quiz.id %>/import">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="csv-file">CSV file</label><input id="csv-file" type="file" accept=".csv,text/csv" data-csv-file><div class="help" data-csv-info></div></div>
          <div class="field"><label for="csv-text">…or paste CSV</label><textarea id="csv-text" name="csv" rows="5" data-csv-text placeholder="question,option_a,option_b,option_c,option_d,correct,marks,explanation" style="font-family: var(--mono); font-size: .85rem"></textarea></div>
          <button class="btn btn-outline">Import questions</button>
        </form>
      </section>
    <% } %>
  </div>

  <div class="stack">
    <section class="card narrow-form" id="settings">
      <h2>Schedule &amp; rules</h2>
      <form method="post" action="/faculty/quizzes/<%= quiz.id %>/settings" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/quiz-fields', { values: quiz }) %>
        <button class="btn btn-primary btn-block">Save settings</button>
      </form>
    </section>
    <section class="card">
      <h2>More actions</h2>
      <div class="stack">
        <form method="post" action="/faculty/quizzes/<%= quiz.id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-block">Duplicate as new draft</button></form>
        <% if (quiz.published && !locked) { %>
          <form method="post" action="/faculty/quizzes/<%= quiz.id %>/unpublish" data-confirm="Students will no longer see this quiz." data-confirm-label="Unpublish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-block">Unpublish (back to draft)</button></form>
        <% } %>
        <form method="post" action="/faculty/quizzes/<%= quiz.id %>/delete" data-confirm="Delete this quiz and all of its results? This can't be undone." data-confirm-label="Delete quiz" data-danger><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-outline btn-block">Delete quiz</button></form>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/foot', { scripts: ['/static/js/editor.js'] }) %>
