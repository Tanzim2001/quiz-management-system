# Copy to .env (optional) or export these before `npm start`. All have sensible defaults.

# Port and interface. Use HOST=0.0.0.0 to open the site from a phone on the same Wi-Fi.
PORT=3000
HOST=localhost

# Where the SQLite database and auto-generated session secret live (default: ./data)
# DATA_DIR=data
# DB_PATH=data/quizhub.db

# Session signing secret. If unset, a random one is generated once and stored in data/.session-secret
# SESSION_SECRET=change-me

# If set, faculty must enter this code to register (students never need it)
# FACULTY_INVITE_CODE=

# NODE_ENV=production
